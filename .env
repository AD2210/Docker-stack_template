### Droit dev
USER_ID=1000
GROUP_ID=1000

### Image prefix indentifier, optionnel
#IMAGES_PREFIX=tmp

### postgres version, charset, optionnel
POSTGRES_VERSION=16
POSTGRES_CHARSET=utf8

### Doctrine DBAL, defaults pour les commandes locales hors Compose
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_VERSION=16
DATABASE_CHARSET=utf8
DATABASE_NAME=app-dev
DATABASE_USER=dev
DATABASE_PASSWORD_FILE=secrets/postgres_password
#DATABASE_HOST_IP=127.0.0.1

### php service, fallback dans app.yaml
DEFAULT_URI=http://localhost
#SERVER_NAME=localhost
#PHP_HTTP_PORT=8000
#PHP_HOST_IP=127.0.0.1

### services de developpement
#MAILER_SMTP_PORT=1025
#MAILER_HTTP_PORT=8025
#MAILER_HOST_IP=127.0.0.1

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/mercure-bundle ###
MERCURE_URL=http://php/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:8002/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_JWT_ALG=HS256
###< symfony/mercure-bundle ###
